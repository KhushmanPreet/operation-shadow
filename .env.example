# Operation Shadow Environment Configuration

# Application Environment
SHADOW_ENV=development
SHADOW_HOST=127.0.0.1
SHADOW_PORT=8000

# Structured Application Logging
SHADOW_LOG_LEVEL=INFO
SHADOW_LOG_JSON=true

# Asynchronous SQLite Database URL (SQLAlchemy 2.0 + aiosqlite)
SHADOW_DATABASE_URL=sqlite+aiosqlite:///./operation_shadow.db

# Shared-Secret Token for Vehicle WebSocket Gateway & Manual Override REST Endpoint (§5.1, §9)
SHADOW_VEHICLE_SHARED_SECRET=change-me-local-demo-secret

# Safety & Hardware Lockout Controls
# MUST remain true until TRD v2.0 §7 and Hardware & IoT specifications are verified.
SHADOW_HARDWARE_LOCKOUT=true
SHADOW_DEFAULT_VEHICLE_MODE=simulated

# Provisional Vehicle Heartbeat Timing (Hardware & IoT doc §5.2 unresolved; see docs/assumptions.md)
SHADOW_HEARTBEAT_INTERVAL_MS=250
SHADOW_HEARTBEAT_TIMEOUT_MS=1500

# CORS Origins for Local React Dashboard
SHADOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite Environment Variables
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/dashboard
